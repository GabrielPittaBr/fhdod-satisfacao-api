# O que fica fora do contexto do docker build da API: o que a imagem não usa e o que não pode entrar nela.
# Os caminhos são da raiz do repositório; **/ pega o nome em qualquer pasta.

# Dependências e resultados gerados na máquina: a imagem instala e gera os seus.
node_modules
dist
coverage
src/generated
.pnpm-store
*.tsbuildinfo

# Segredos: nenhum .env entra na imagem (nem o infra/.env do servidor), nem a configuração do destino do backup.
**/.env
**/.env.*
infra/backup/rclone.conf

# A infraestrutura do servidor: o compose e o backup, que tem a própria imagem.
infra

# Git, CI, editores e agentes.
.git
.github
.husky
.claude
.vscode
.idea

# Documentação, testes, o contrato e logs: não fazem parte da API que roda.
docs
tests
*.md
openapi.json
**/*.log

# A própria configuração do Docker.
Dockerfile
.dockerignore
docker-compose.yml
