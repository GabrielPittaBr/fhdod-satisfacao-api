# Variáveis de ambiente da API. Para desenvolver, copie para .env: os valores abaixo já funcionam com o
# PostgreSQL do docker-compose.yml. O .env nunca vai para o Git; aqui ficam só nomes e exemplos falsos.
# Se faltar alguma obrigatória ou alguma estiver errada, a API não sobe e diz qual é.

# Obrigatória. Ambiente: development, test ou production.
NODE_ENV=development

# Porta da API. Padrão: 3333.
PORT=3333

# Obrigatória. Conexão do Prisma com o PostgreSQL (aqui, o banco de desenvolvimento do docker compose).
DATABASE_URL=postgresql://app:app@localhost:5432/satisfacao

# Obrigatória. Origem do front aceita pelo CORS; várias origens vão separadas por vírgula.
CORS_ORIGIN=http://localhost:5173

# Nível dos logs: fatal, error, warn, info, debug, trace ou silent. Padrão: info.
LOG_LEVEL=info

# Swagger em /api/docs e o contrato em /api/docs/openapi.json: true ou false. Padrão: ligado em development
# e test, desligado em production. A homologação roda em production e liga com DOCS_ENABLED=true.
DOCS_ENABLED=true

# Só para os testes (a API não lê): banco de teste, se não for o postgres-teste do docker compose.
# TEST_DATABASE_URL=postgresql://app:app@localhost:5433/satisfacao_teste
