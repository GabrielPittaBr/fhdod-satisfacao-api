# Variáveis de ambiente da API. Para desenvolver, copie para .env: os valores abaixo já funcionam com o
# PostgreSQL do docker-compose.yml. O .env nunca vai para o Git; aqui ficam só nomes e exemplos falsos.
# Se faltar alguma obrigatória ou alguma estiver errada, a API não sobe e diz qual é.

# Obrigatória. Ambiente: development, test ou production.
NODE_ENV=development

# Porta da API. Padrão: 3333.
PORT=3333

# Obrigatória. Conexão do Prisma com o PostgreSQL (aqui, o banco de desenvolvimento do docker compose).
DATABASE_URL=postgresql://app:app@localhost:5432/satisfacao

# Obrigatória. Origem do front aceita pelo CORS; várias origens vão separadas por vírgula.
CORS_ORIGIN=http://localhost:5173

# Nível dos logs: fatal, error, warn, info, debug, trace ou silent. Padrão: info.
LOG_LEVEL=info

# Swagger em /api/docs e o contrato em /api/docs/openapi.json: true ou false. Padrão: ligado em development
# e test, desligado em production. A homologação roda em production e liga com DOCS_ENABLED=true.
DOCS_ENABLED=true

# Obrigatória. Segredo que assina os tokens de acesso (JWT), com pelo menos 32 caracteres. Quem o tem
# consegue entrar como qualquer usuário. O valor abaixo é só para desenvolver: em homologação e produção,
# gere outro com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=segredo-de-desenvolvimento-troque-fora-da-sua-maquina

# Validade do token de acesso: um tempo como 15m, 900s ou 1h. Padrão: 15m.
ACCESS_TOKEN_TTL=15m

# Validade do refresh token, em dias, contada de novo a cada renovação. Padrão: 7.
REFRESH_TOKEN_TTL_DAYS=7

# Obrigatória. Chave da cifra dos telefones de retorno (AES-256-GCM): 32 bytes em base64. Quem a tem lê os
# telefones de uma cópia do banco, e sem ela os telefones já gravados não se leem mais: guarde-a fora do
# servidor também. O valor abaixo é só para desenvolver: em homologação e produção, gere outra com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=Y2hhdmUtZGUtZGVzZW52b2x2aW1lbnRvLXRyb3F1ZSE=

# IPs fora do limite de envios da pesquisa pública, separados por vírgula: o IP público do hospital, por
# onde saem os totens, para o limite não bloquear os pacientes. Vazia, o limite vale para todos.
RATE_LIMIT_ALLOWLIST=

# Só para o seed (a API não lê): e-mail e senha do primeiro Super Admin, que o `pnpm db:seed` cria quando o
# banco ainda não tem usuários. A senha segue a regra (pelo menos 10 caracteres, com letras e números) e vale
# como provisória: a troca é pedida no primeiro acesso. Com a conta criada, as duas podem sair do servidor.
SEED_ADMIN_EMAIL=admin@exemplo.com.br
SEED_ADMIN_PASSWORD=troque-no-primeiro-acesso-1

# Só para os dados de demonstração (`pnpm db:demo`; a API não lê): as senhas das cinco contas de demonstração,
# uma por variável. Sem elas, valem as do repositório, que estão no README e são públicas: servem só na sua
# máquina. Com NODE_ENV=production, como na homologação, o comando exige as cinco. Cada uma segue a regra de
# senha. A confirmação do comando (DEMO_CONFIRM) não fica aqui: vai na linha do comando, a cada vez.
# DEMO_PASSWORD_SUPER_ADMIN=
# DEMO_PASSWORD_GESTOR=
# DEMO_PASSWORD_OUVIDORIA=
# DEMO_PASSWORD_VISUALIZADOR=
# DEMO_PASSWORD_PRIMEIRO_ACESSO=

# Só para os testes (a API não lê): banco de teste, se não for o postgres-teste do docker compose.
# TEST_DATABASE_URL=postgresql://app:app@localhost:5433/satisfacao_teste
