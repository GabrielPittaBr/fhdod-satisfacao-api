# Variáveis do servidor de homologação ou de produção, lidas pelo infra/docker-compose.prod.yml. No servidor,
# copie este arquivo para infra/.env (cp infra/.env.example infra/.env) e preencha. O infra/.env nunca vai para
# o Git; aqui ficam só os nomes e exemplos falsos. Sem uma obrigatória, o compose não sobe e diz qual falta.
#
# Gere cada segredo só para este servidor, nunca reaproveite o de outro ambiente nem os do .env.example da raiz,
# e guarde uma cópia deles fora do servidor (num cofre de senhas do time). Os comandos abaixo usam o openssl,
# que vem no Linux; os valores gerados só têm caracteres que o .env e as URLs aceitam sem aspas.

# ---------- Site ----------

# Obrigatória. Domínio do site, como pesquisa.exemplo.com.br. Com ele, o Caddy emite e renova o HTTPS sozinho:
# o DNS precisa apontar para o servidor, e as portas 80 e 443 (TCP e UDP) precisam estar abertas. Para testar
# na sua máquina, :80 serve em HTTP, e localhost, em HTTPS com o certificado do próprio Caddy.
DOMAIN=

# Obrigatória. Endereço do site, com https:// e sem barra no fim, como https://pesquisa.exemplo.com.br: a origem
# aceita pela API e a base do link da TV que os dados de demonstração mostram.
CORS_ORIGIN=

# ---------- Banco ----------

# Obrigatória. Senha do usuário app do PostgreSQL, que a API e o backup usam. Gere com: openssl rand -hex 32
# Ela só vale na criação do volume do banco: para trocá-la depois, mude-a também no banco (README, em
# "Produção e homologação").
POSTGRES_PASSWORD=

# ---------- API ----------

# Obrigatória. Segredo que assina os tokens de acesso: quem o tem entra como qualquer usuário.
# Gere com: openssl rand -hex 48
JWT_ACCESS_SECRET=

# Obrigatória. Chave da cifra dos telefones de retorno: 32 bytes em base64. Gere com: openssl rand -base64 32
# Sem ela, os telefones gravados não se leem mais, nem os das cópias do backup: guarde-a fora do servidor, e
# nunca junto com as cópias.
ENCRYPTION_KEY=

# IP público do hospital, por onde saem os totens, fora do limite de envios da pesquisa; vários vão separados
# por vírgula. Vazia, o limite vale para todos, e os totens podem ser barrados num dia de muito movimento.
RATE_LIMIT_ALLOWLIST=

# Swagger em /api/docs: true na homologação, que os desenvolvedores usam; vazia (desligado) em produção.
DOCS_ENABLED=

# Opcionais, com o padrão da API quando vazias: nível dos logs (info), validade do token de acesso (15m) e do
# refresh token, em dias (7). O .env.example da raiz explica cada uma.
LOG_LEVEL=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL_DAYS=

# ---------- Primeiro acesso ----------

# E-mail e senha do primeiro Super Admin, criado pelo seed base quando a API sobe com o banco ainda sem
# usuários. A senha segue a regra (pelo menos 10 caracteres, com letras e números) e vale como provisória: a
# troca é pedida no primeiro acesso. Obrigatórias na primeira publicação (sem elas, a API não sobe e diz o que
# falta); com a conta criada, podem ser apagadas daqui.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------- Backup ----------

# Obrigatória. Para onde vai a cópia de fora do servidor: um caminho do rclone, com o remoto e a pasta, como
# fora:fhdod-backups/producao. O remoto fora fica no infra/backup/rclone.conf (o modelo, com o S3 e o SFTP, é o
# infra/backup/rclone.conf.example). Use nenhum só onde a cópia de fora não é necessária, como num teste na
# sua máquina: em produção, sem ela, um disco perdido leva o banco e as cópias juntos.
BACKUP_DESTINO=

# ---------- Banco fora do servidor (opcional) ----------

# Só com o infra/docker-compose.banco-externo.yml, que tira do servidor o postgres e o backup, para o banco ficar
# num serviço de fora, como o Supabase (README, em "Produção e homologação"): a URL do PostgreSQL de lá, que a
# API usa no lugar da do compose. No Supabase, a do Session pooler, com ?sslmode=no-verify no fim: a conexão vai
# cifrada, e o sslmode=require do pg exigiria um certificado que o Node conhece, o que o do Supabase não é. Com o
# banco de fora, o POSTGRES_PASSWORD e o BACKUP_DESTINO continuam obrigatórios, mas não são usados.
# DATABASE_URL=

# ---------- Dados de demonstração (só na homologação) ----------

# As senhas das cinco contas de demonstração, uma por variável, para o comando dos dados de demonstração
# (README, em "Produção e homologação"). Com NODE_ENV=production, o comando exige as cinco. Nunca em produção.
# DEMO_PASSWORD_SUPER_ADMIN=
# DEMO_PASSWORD_GESTOR=
# DEMO_PASSWORD_OUVIDORIA=
# DEMO_PASSWORD_VISUALIZADOR=
# DEMO_PASSWORD_PRIMEIRO_ACESSO=
